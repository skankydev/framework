{
    "name": "skankydev/framework",
    "description": "Un petit framework PHP MVC maison, pensé pour faire du CRUD sur MongoDB sans se prendre la tête.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SkankyDev\\": "src/"
        },
        "files": [
            "src/constant.php",
            "src/debug.php",
            "src/function.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SkankyTest\\": "tests/SkankyTest",
            "TestApp\\View\\Part\\": "tests/App/View/part",
            "TestApp\\":    "tests/App"
        }
    },
    "authors": [
        {
            "name": "Skankydev",
            "email": "simon.schenck@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "mongodb/mongodb": "^2.1",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "coverage-pretty": "phpunit --coverage-html build/coverage"
    },
    "config": {
        "sort-packages": true
    }
}
